.sdd/
beatroot.db
beatroot.checkpoints.db
# SQLite writes -wal and -shm sidecars next to the database in WAL mode.
# Ignoring only the .db leaves those two untracked, and a `git add -A` then
# commits several MB of binary checkpoint state — which is exactly what
# happened once.
beatroot.db-*
beatroot.checkpoints.db-*
