        <mxCell id="subtitle" value="LangGraph StateGraph over a SqliteSaver checkpointer. Every terminal state writes an audit record. interrupt_before=[&quot;commit&quot;] is the confirmation boundary." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#52606d;" vertex="1" parent="1">
