        </mxCell>
        <mxCell id="n_nut" value="NUTRITION MATH&#xa;&#xa;provenance = &quot;computed&quot;&#xa;the type system forbids a model value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="t0">
