        <mxCell id="n_compile" value="COMPILE&#xa;&#xa;open-vocabulary interpreter&#xa;model proposes category &#8594; CODE maps to Severity&#xa;identity kinds floored at DIETARY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="t0">
          <mxGeometry x="20" y="45" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_feas" value="FEASIBILITY&#xa;&#xa;bitmask over inverted tag index&#xa;O(constraints), not O(catalog)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="t0">
          <mxGeometry x="320" y="45" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_verify" value="VERIFY&#xa;&#xa;re-checks the recipe (no model)&#xa;diffs every stated number vs catalog truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="t0">
