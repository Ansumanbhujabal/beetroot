# Leave everything blank to run fully offline and deterministic.
BEATROOT_OFFLINE=1

# LiteLLM reads provider credentials directly from standard env names.
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-10-21

OLLAMA_API_BASE=http://localhost:11434

# Vector store. Set by docker compose; unset means the NumPy dev fallback.
QDRANT_URL=

# Optional tracing and prompt management. Every call no-ops without these,
# so a reviewer with this file copied verbatim runs fully offline.
#
# LANGFUSE_HOST is NOT optional once the keys are set: it defaults to the US
# cloud, so EU-region keys authenticate nowhere and traces disappear in
# silence, because ingestion is fire-and-forget. The SDK's own auth_check()
# does not catch this — it returns True against both regions. Set the host
# explicitly and run `uv run beatroot obs check`, which makes a real
# authenticated API call and names the project it reached.
#   EU: https://cloud.langfuse.com
#   US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Any config/beatroot.yaml value is overridable, e.g.
# BEATROOT_TRUST__REFUSAL_THRESHOLD=0.7
